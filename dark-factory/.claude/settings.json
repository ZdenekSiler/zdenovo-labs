{
  "permissions": {
    "allow": [
      "Bash(python3 run.py status:*)",
      "Bash(python3 run.py report:*)",
      "Bash(python3 run.py requeue:*)",
      "Bash(python3 run.py run:*)",
      "Bash(sqlite3 work/factory.db:*)",
      "Bash(ollama list:*)",
      "Read(work/**)",
      "Edit(work/out/REVIEW.md)"
    ],
    "deny": [
      "Edit(factory/checks.py)",
      "Edit(work/factory.db)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(scripts/chaos.sh:*)",
      "Bash(python3 run.py blackout:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/require_review.sh"
          }
        ]
      }
    ]
  }
}
